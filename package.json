{
  "name": "stack-template-light",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview --port 4173 --host 127.0.0.1 --strictPort",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm guard",
    "guard": "pnpm guard:tests && pnpm guard:migrations && pnpm guard:secrets && pnpm guard:escapes && pnpm guard:template && pnpm guard:cloudflare",
    "guard:tests": "node scripts/guard-tests.mjs",
    "guard:migrations": "node scripts/guard-migrations.mjs",
    "guard:secrets": "node scripts/guard-secrets.mjs",
    "guard:escapes": "node scripts/guard-escape-hatches.mjs",
    "guard:template": "node scripts/guard-template.mjs",
    "guard:cloudflare": "node scripts/guard-cloudflare.mjs",
    "apparaat:nieuw": "node scripts/apparaat-nieuw.mjs",
    "db:lokaal": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@sentry/react": "^11.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vite-plugin": "^1.63.2",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.150.0",
    "yaml": "^2.9.1"
  }
}
